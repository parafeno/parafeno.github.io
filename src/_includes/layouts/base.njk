<!doctype html>
<html lang="{{ site.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titulo %}{{ titulo }} — {{ site.nombre }}{% else %}{{ site.nombre }}{% endif %}</title>
  <meta name="description" content="{{ descripcion or site.descripcion }}">
  <link rel="stylesheet" href="/assets/css/estilo.css">
</head>
<body>

  <header class="cabecera">
    <a class="marca" href="/">{{ site.nombre }}</a>
    <nav class="menu">
      <a href="/" {% if page.url == "/" %}class="activo"{% endif %}>Todo</a>
      <a href="/comercial/" {% if page.url == "/comercial/" %}class="activo"{% endif %}>Comercial</a>
      <a href="/personal/" {% if page.url == "/personal/" %}class="activo"{% endif %}>Personal</a>
      <a href="/sobre/" {% if page.url == "/sobre/" %}class="activo"{% endif %}>Sobre</a>
    </nav>
  </header>

  <main class="contenido">
    {{ content | safe }}
  </main>

  <footer class="pie">
    <p>{{ site.autor }} · Madrid · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  </footer>

</body>
</html>
