<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titulo %}{{ titulo }} — {{ site.nombre }}{% else %}{{ site.nombre }}{% endif %}</title>
  <meta name="description" content="{{ descripcion or site.descripcion }}">
  <link rel="stylesheet" href="/assets/css/estilo.css">
</head>
<body>

<div class="marco{% if page.url == "/" %} portada{% endif %}">

  <aside class="lateral">

    <a class="marca" href="/">{{ site.nombre }}</a>

    <nav class="indice">

      {# La obra propia va primero y sin adjetivos. Los encargos van debajo,
         etiquetados como lo que son. El titulo de cada apartado es texto
         estatico, no un enlace: /art/ y /commissions/ ya se ven mediante el
         "+" de abajo. El indice solo ensena los primeros N proyectos
         (--limite-indice) para no crecer sin fin; el "+" final lleva a la
         rejilla completa de la categoria. Una exposicion conjunta se ve
         como un desplegable: el titulo enlaza a su ficha, la flecha nativa
         del <details> abre la lista de piezas sin salir de la pagina. #}
      {% set limiteIndice = 5 %}

      <span class="indice-titulo">Art</span>
      <ul>
        {% for p in collections.personalesAgrupado | limitar(limiteIndice) %}
          <li>
            {% if p.esExposicion %}
              <details class="indice-expo" {% if page.url == p.url or (p.piezas | contieneUrl(page.url)) %}open{% endif %}>
                <summary>
                  <a href="{{ p.url }}" {% if page.url == p.url %}class="activo"{% endif %}>{{ p.data.titulo }}</a>
                </summary>
                <ul>
                  {% for pieza in p.piezas %}
                    <li><a href="{{ pieza.url }}" {% if page.url == pieza.url %}class="activo"{% endif %}>{{ pieza.data.titulo }}</a></li>
                  {% endfor %}
                </ul>
              </details>
            {% else %}
              <a href="{{ p.url }}" {% if page.url == p.url %}class="activo"{% endif %}>{{ p.data.titulo }}</a>
            {% endif %}
          </li>
        {% endfor %}
        {% if collections.personalesAgrupado.length > limiteIndice %}
          <li><a class="indice-mas" href="/art/" title="See all art">+</a></li>
        {% endif %}
      </ul>

      <span class="indice-titulo">Commissions</span>
      <ul>
        {% for p in collections.comercialesAgrupado | limitar(limiteIndice) %}
          <li>
            {% if p.esExposicion %}
              <details class="indice-expo" {% if page.url == p.url or (p.piezas | contieneUrl(page.url)) %}open{% endif %}>
                <summary>
                  <a href="{{ p.url }}" {% if page.url == p.url %}class="activo"{% endif %}>{{ p.data.titulo }}</a>
                </summary>
                <ul>
                  {% for pieza in p.piezas %}
                    <li><a href="{{ pieza.url }}" {% if page.url == pieza.url %}class="activo"{% endif %}>{{ pieza.data.titulo }}</a></li>
                  {% endfor %}
                </ul>
              </details>
            {% else %}
              <a href="{{ p.url }}" {% if page.url == p.url %}class="activo"{% endif %}>{{ p.data.titulo }}</a>
            {% endif %}
          </li>
        {% endfor %}
        {% if collections.comercialesAgrupado.length > limiteIndice %}
          <li><a class="indice-mas" href="/commissions/" title="See all commissions">+</a></li>
        {% endif %}
      </ul>

      <ul class="indice-fijo">
        <li><a href="/bio/" {% if page.url == "/bio/" %}class="activo"{% endif %}>Bio</a></li>
        <li><a href="/press/" {% if page.url == "/press/" %}class="activo"{% endif %}>Press</a></li>
        <li><a href="/contact/" {% if page.url == "/contact/" %}class="activo"{% endif %}>Contact</a></li>
      </ul>

    </nav>
  </aside>

  <main class="contenido">
    {{ content | safe }}
  </main>

</div>

</body>
</html>
