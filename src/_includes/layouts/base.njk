<!doctype html>
<html lang="{{ site.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titulo %}{{ titulo }} — {{ site.nombre }}{% else %}{{ site.nombre }}{% endif %}</title>
  <meta name="description" content="{{ descripcion or site.descripcion }}">
  <link rel="stylesheet" href="/assets/css/estilo.css">
</head>
<body>

<div class="marco">

  <aside class="lateral">

    <a class="marca" href="/">{{ site.nombre }}</a>

    <nav class="indice">

      <a class="indice-titulo" href="/comercial/">Comercial</a>
      <ul>
        {% for p in collections.comerciales %}
          <li><a href="{{ p.url }}" {% if page.url == p.url %}class="activo"{% endif %}>{{ p.data.titulo }}</a></li>
        {% endfor %}
      </ul>

      <a class="indice-titulo" href="/personal/">Personal</a>
      <ul>
        {% for p in collections.personales %}
          <li><a href="{{ p.url }}" {% if page.url == p.url %}class="activo"{% endif %}>{{ p.data.titulo }}</a></li>
        {% endfor %}
      </ul>

      <ul class="indice-fijo">
        <li><a href="/sobre/" {% if page.url == "/sobre/" %}class="activo"{% endif %}>Sobre</a></li>
        <li><a href="mailto:{{ site.email }}">Contacto</a></li>
      </ul>

    </nav>
  </aside>

  <main class="contenido">
    {{ content | safe }}
  </main>

</div>

</body>
</html>
