---
layout: layouts/base.njk
---
{% from "partials/media.njk" import pieza %}

<article class="proyecto">

  <h1 class="proyecto-titulo">{{ titulo }}</h1>

  <div class="proyecto-datos">
    {% if cliente and (cliente | lower) != (titulo | lower) %}<p>{{ cliente }}</p>{% endif %}
    {% for d in datos %}<p>{{ d | safe }}</p>{% endfor %}
    {% if anio %}<p>{{ anio }}</p>{% endif %}
    {% if exposicion %}
      {% set expo = collections.exposiciones | porSlug(exposicion) %}
      {% if expo %}<p>Part of the exhibition <a href="{{ expo.url }}">{{ expo.data.titulo }}</a></p>{% endif %}
    {% endif %}
  </div>

  {% if media and media.length %}
    <div class="proyecto-media">
      {% for item in media %}
        {{ pieza(item, titulo) }}
      {% endfor %}
    </div>
  {% endif %}

  {% if content %}
    <div class="proyecto-texto prosa">
      {{ content | safe }}
    </div>
  {% endif %}

  {% if creditos and creditos.length %}
    <div class="proyecto-creditos">
      <p>Credits:</p>
      {% for c in creditos %}<p>{{ c | safe }}</p>{% endfor %}
    </div>
  {% endif %}

</article>
