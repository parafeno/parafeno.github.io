---
layout: layouts/base.njk
---
{% from "partials/media.njk" import pieza %}
{% from "partials/rejilla.njk" import lista %}

<article class="proyecto">

  <h1 class="proyecto-titulo">{{ titulo }}</h1>

  <div class="proyecto-datos">
    {% if cliente %}<p>{{ cliente }}</p>{% endif %}
    {% if rol %}<p>{{ rol }}</p>{% endif %}
    <p>{% if estudio %}{{ estudio }}, {% endif %}{{ anio }}</p>
  </div>

  {% if media and media.length %}
    <div class="proyecto-media">
      {% for item in media %}
        {{ pieza(item, titulo) }}
      {% endfor %}
    </div>
  {% endif %}

  {% if content %}
    <div class="proyecto-texto prosa">
      {{ content | safe }}
    </div>
  {% endif %}

  {% if creditos and creditos.length %}
    <div class="proyecto-creditos">
      <p>Créditos:</p>
      {% for c in creditos %}<p>{{ c }}</p>{% endfor %}
    </div>
  {% endif %}

  <div class="proyecto-otros">
    <p class="etiqueta">Otros proyectos:</p>
    {{ lista(collections.proyectos | otros(page.url, 8)) }}
  </div>

</article>
