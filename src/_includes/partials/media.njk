{# ------------------------------------------------------------------
   Macro que dibuja UNA pieza de media dentro de un proyecto.
   Entiende cuatro tipos: imagen, vimeo, youtube y video (archivo suelto).
   Si algun dia cambias de sistema de video, se toca solo este archivo.
   ------------------------------------------------------------------ #}

{% macro pieza(item, alt_por_defecto = "") %}
  {% set ratio = item.ratio or "16 / 9" %}

  <figure class="media media--{{ item.tipo }}">

    {% if item.tipo == "imagen" %}
      {% imagen item.src, item.alt or alt_por_defecto %}

    {% elif item.tipo == "vimeo" %}
      <div class="marco" style="aspect-ratio: {{ ratio }}; --ratio: {{ ratio }}">
        <iframe src="https://player.vimeo.com/video/{{ item.id }}?title=0&amp;byline=0&amp;portrait=0&amp;dnt=1"
                title="{{ item.caption or alt_por_defecto }}"
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen></iframe>
      </div>

    {% elif item.tipo == "youtube" %}
      <div class="marco" style="aspect-ratio: {{ ratio }}; --ratio: {{ ratio }}">
        <iframe src="https://www.youtube-nocookie.com/embed/{{ item.id }}?rel=0"
                title="{{ item.caption or alt_por_defecto }}"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
                allowfullscreen></iframe>
      </div>

    {% elif item.tipo == "video" %}
      {# Loop corto sin sonido, alojado en el propio repositorio.
         El poster es la imagen que se ve mientras carga el video. #}
      <video {% if item.poster %}poster="{{ item.poster }}"{% endif %}
             style="aspect-ratio: {{ ratio }}; --ratio: {{ ratio }}"
             playsinline muted loop autoplay preload="metadata">
        {% if item.webm %}<source src="{{ item.webm }}" type="video/webm">{% endif %}
        <source src="{{ item.src }}" type="video/mp4">
      </video>
    {% endif %}

    {% if item.caption %}<figcaption>{{ item.caption }}</figcaption>{% endif %}
  </figure>
{% endmacro %}
