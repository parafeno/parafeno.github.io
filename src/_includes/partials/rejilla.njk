{# ------------------------------------------------------------------
   rejilla(): miniaturas en cuadricula. Se usa en la portada y en las
   paginas de Art y Commissions.

   Un item normal es un proyecto. Un item con "esExposicion: true" es
   una exposicion conjunta: se ve como una sola tarjeta con un icono
   que indica que agrupa varias piezas, y lleva a la ficha de la
   exposicion en vez de a un proyecto.
   ------------------------------------------------------------------ #}

{% macro rejilla(proyectos) %}
  <ul class="rejilla">
    {% for p in proyectos %}
      <li class="tarjeta{% if p.esExposicion %} tarjeta-exposicion{% endif %}">
        <a href="{{ p.url }}">
          <div class="tarjeta-imagen">
            {% if p.data.miniatura %}
              {% imagen p.data.miniatura.src,
                        p.data.miniatura.alt or p.data.titulo,
                        "(max-width: 760px) 50vw, 300px" %}
            {% endif %}
          </div>
          <div class="tarjeta-texto">
            <span class="tarjeta-titulo">
              {{ p.data.titulo }}
              {% if p.esExposicion %}<span class="tarjeta-icono" aria-hidden="true" title="Group exhibition">⊞</span>{% endif %}
            </span>
            <span class="tarjeta-meta">
              {%- if p.esExposicion -%}
                {{ p.piezas.length }} works
              {%- else -%}
                {%- if p.data.cliente and (p.data.cliente | lower) != (p.data.titulo | lower) %}{{ p.data.cliente }} · {% endif -%}
                {{ p.data.anio }}
              {%- endif -%}
            </span>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
{% endmacro %}
